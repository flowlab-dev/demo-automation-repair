    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Same bookkeeping for the review branch: the order is stored in the\n// \"Needs review\" tab, so the cursor may pass it — but no email is sent.\n// Runs only after the row exists in the sheet. Both the memory of handled\n// orders and the cursor move here — never earlier — so anything that fails\n// on the way is simply read again by the next run.\nconst store = $getWorkflowStaticData('global');\nif (!store.handled) store.handled = {};\n\nconst items = $input.all();\nlet newest = store.cursor;\n\nfor (const item of items) {\n  const id = item.json.order_id;\n  const stamp = item.json.updated_at || item.json.placed_at;\n  if (id) store.handled[id] = stamp;\n  if (stamp && (!newest || stamp > newest)) newest = stamp;\n}\n\nstore.cursor = newest;\n\n// Forget orders older than three days, otherwise the store grows for ever.\nconst cutoff = new Date(new Date(newest).getTime() - 3 * 24 * 60 * 60 * 1000).toISOString();\nfor (const id of Object.keys(store.handled)) {\n  if (store.handled[id] < cutoff) delete store.handled[id];\n}\n\nreturn items;"
      },
