    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The cursor is the only thing that decides what we ask the shop for.\n// It is written at the very end of a run, after the orders are safely stored.\nconst store = $getWorkflowStaticData('global');\n\nif (!store.cursor) {\n  store.cursor = $now.minus({ minutes: 15 }).toISO();\n}\n\n// Deliberate overlap. The shop's queue publishes an order some time after its\n// updated_at timestamp, so a window starting exactly at the cursor skips those\n// orders for ever. The overlap must be larger than the worst publishing delay\n// the shop shows in practice — measure it before trusting this number.\n// Everything the overlap re-reads is dropped again by \"Skip orders already handled\".\nconst overlapMinutes = 10;\nconst from = new Date(new Date(store.cursor).getTime() - overlapMinutes * 60 * 1000).toISOString();\n\nreturn [{ json: { cursor: from } }];"
      },
      "id": "f1a00000-0000-4000-8000-000000000002",
      "name": "Load cursor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ]
    },
