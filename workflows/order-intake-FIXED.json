    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Drops what we have already stored, and tells a genuine update apart from a\n// repeat. An order is remembered only after its row is written (see \"Remember\n// what was stored\"), so a crash before the write cannot lose it.\nconst store = $getWorkflowStaticData('global');\nif (!store.handled) store.handled = {};\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const order = item.json;\n  const storedAt = store.handled[order.id];\n\n  // Exactly what we stored last time: nothing to do.\n  if (storedAt && storedAt === order.updated_at) continue;\n\n  // Same order, newer timestamp: the customer changed something.\n  order.is_update = Boolean(storedAt);\n  out.push({ json: order });\n}\n\nreturn out;"
      },
      "id": "f1a00000-0000-4000-8000-000000000006",
      "name": "Skip orders already handled",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs per item: one malformed order can no longer take the whole batch down.\n// Missing optional fields get a safe default; anything we cannot act on is\n// flagged for a human instead of being dropped.\nconst o = $json;\nconst customer = o.customer || {};\n\nconst first = String(customer.first_name || '').trim();\nconst last = String(customer.last_name || '').trim();\nconst email = String(customer.email || '').trim();\nconst phone = String(customer.phone || '').replace(/[^0-9+]/g, '');\nconst lineItems = Array.isArray(o.line_items) ? o.line_items : [];\n\nconst problems = [];\nif (!email.includes('@')) problems.push('no usable email address');\nif (lineItems.length === 0) problems.push('order has no line items');\n\nreturn {\n  json: {\n    order_id: o.id,\n    customer_name: [first, last].filter(Boolean).join(' ') || 'Customer',\n    email: email,\n    phone: phone,\n    total: o.total_eur,\n    items: lineItems.map(li => li.sku + ' x' + li.qty).join(', '),\n    placed_at: o.created_at,\n    updated_at: o.updated_at,\n    is_update: Boolean(o.is_update),\n    needs_review: problems.length > 0,\n    review_reason: problems.join('; ')\n  }\n};"
      },
