{
  "name": "Palewood — Order intake v3 (live)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "b1a00000-0000-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -180,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.palewood-shop.test/v1/orders",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "updated_since",
              "value": "={{ $now.minus({ minutes: 5, seconds: 40 }).toISO() }}"
            },
            {
              "name": "api_key",
              "value": "pk_live_EXAMPLE_NOT_A_REAL_KEY_7f3c2a"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a00000-0000-4000-8000-000000000002",
      "name": "Fetch new orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "orders",
        "options": {}
      },
      "id": "b1a00000-0000-4000-8000-000000000003",
      "name": "Split orders",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const o = item.json;\n  const name = o.customer.first_name + ' ' + o.customer.last_name.trim();\n  const phone = o.customer.phone.replace(/[^0-9+]/g, '');\n\n  out.push({\n    json: {\n      order_id: o.id,\n      customer_name: name,\n      email: o.customer.email,\n      phone: phone,\n      total: o.total_eur,\n      items: o.line_items.map(li => li.sku + ' x' + li.qty).join(', '),\n      placed_at: o.created_at\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "b1a00000-0000-4000-8000-000000000004",
      "name": "Format order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1PalewoodOrdersSheetExampleId",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Orders",
          "mode": "name",
          "cachedResultName": "Orders"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "b1a00000-0000-4000-8000-000000000005",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        700,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GS_PALEWOOD",
          "name": "Palewood Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Your Palewood order {{ $json.order_id }}",
        "emailType": "text",
        "message": "=Hi {{ $json.customer_name }},\n\nthanks for your order {{ $json.order_id }}.\n\nItems: {{ $json.items }}\nTotal: EUR {{ $json.total }}\n\nWe fire the kiln twice a week and will email you again when your pieces ship.\n\nPalewood Ceramics",
        "options": {}
      },
      "id": "b1a00000-0000-4000-8000-000000000006",
      "name": "Email customer",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        920,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_PALEWOOD",
          "name": "orders@palewood.example"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#orders",
          "mode": "name",
          "cachedResultName": "orders"
        },
        "text": "=New order {{ $json.order_id }} — {{ $json.customer_name }} — EUR {{ $json.total }}",
        "otherOptions": {}
      },
      "id": "b1a00000-0000-4000-8000-000000000007",
      "name": "Notify team in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1140,
        300
      ],
      "credentials": {
        "slackApi": {
          "id": "SLACK_PALEWOOD",
          "name": "Palewood Slack"
        }
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Fetch new orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch new orders": {
      "main": [
        [
          {
            "node": "Split orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split orders": {
      "main": [
        [
          {
            "node": "Format order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format order": {
      "main": [
        [
          {
            "node": "Save to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Google Sheets": {
      "main": [
        [
          {
            "node": "Email customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email customer": {
      "main": [
        [
          {
            "node": "Notify team in Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
